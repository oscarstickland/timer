datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  password String
  firstName String
  lastName String

  timers Timer[]
}

model Timer {
  id Int @id @default(autoincrement())
  name String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId Int

  sessions TimerSession[]
}

model TimerSession {
  id Int @id @default(autoincrement())

  startTime DateTime @default(now())
  endTime DateTime?

  timer Timer @relation(fields: [timerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  timerId Int
}